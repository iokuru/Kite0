{
  "name": "KiteO adapter fixture manifest v3",
  "policy": [
    "Adapters only read: source, language, editor state, page type, contest state. They never modify the editor, the submission or the page.",
    "Adapters contain no complexity logic. The Rust analyzer stays platform independent.",
    "Save sanitized structural fixtures only: minimal DOM, selectors, a stub editor-state object. Never commit cookies, tokens, session IDs, usernames, private source, or large third-party page bodies.",
    "Pages that need a login or JavaScript must be captured by the user by hand (capture_method manual_save_by_user). Do not automate logins, bypass bot protection, or ignore robots.txt and rate limits.",
    "Large raw captures stay in a gitignored cache.",
    "Never capture a page during a live contest."
  ],
  "fixture_format": {
    "files": [
      "fixture.html (sanitized minimal DOM)",
      "editor_state.json (stub: text, language, readOnly)",
      "expected.json (platform, page_type, editor_type, language, contest_state)"
    ],
    "test": "Load fixture.html in Playwright, inject editor_state.json through the same page-context bridge the extension uses, and compare adapter output with expected.json."
  },
  "support_status_values": [
    "untested",
    "mock_page",
    "saved_real_page",
    "live_verified"
  ],
  "support_rule": "An adapter may be listed as supported only at saved_real_page or live_verified.",
